SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/vegan?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Set a unique random secret of at least 32 bytes.
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-bytes

GOOGLE_CLIENT_ID=your-google-oauth-client-id
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-strong-password-14-72-bytes

PAYOS_API_URL=https://api-merchant.payos.vn/v2/payment-requests
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# AI features stay disabled until a server-side key is configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
